{
  "name": "tahaddi-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=11"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/prepare-three-decoders.mjs",
    "setup:env": "node scripts/setup-local-env.mjs",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @tahaddi/web dev",
    "dev:realtime": "pnpm --filter @tahaddi/realtime dev",
    "dev:3d": "node scripts/blender.mjs dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:blender && node scripts/check-public-supabase-exposure.mjs --env-only && node scripts/check-no-ladder-prisma-models.mjs && turbo test",
    "test:blender": "node --test scripts/blender-cli.test.mjs",
    "test:3d": "pnpm --filter @tahaddi/web exec playwright test --config playwright.3d.config.ts",
    "blender:create:challenge-card": "node scripts/blender.mjs create",
    "blender:export": "node scripts/blender.mjs export",
    "blender:export:all": "node scripts/blender.mjs export-all",
    "blender:watch": "node scripts/blender.mjs watch",
    "blender:preview": "node scripts/blender.mjs preview",
    "release:check": "node scripts/assert-clean-vercel-release.mjs",
    "deploy:vercel:preview": "pnpm release:check && vercel deploy --yes",
    "loadtest:smoke": "k6 run tests/load/http-smoke.js",
    "loadtest:realtime": "k6 run tests/load/realtime-handshake.js",
    "loadtest:all": "pnpm loadtest:smoke && pnpm loadtest:realtime",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "node scripts/db-migrate-deploy.mjs",
    "db:seed": "prisma db seed",
    "db:organize-questions": "tsx scripts/organize-question-bank.ts",
    "db:repair-question-tree": "tsx scripts/repair-question-bank-tree.ts",
    "db:audit-questions": "tsx scripts/audit-question-bank.ts",
    "db:import-ladder-csv": "tsx scripts/import-ladder-csv.ts",
    "db:seed-scrambled-words": "tsx scripts/seed-scrambled-words-puzzles.ts",
    "db:curate-questions": "tsx scripts/curate-question-bank.ts",
    "db:curate-questions:dry": "tsx scripts/curate-question-bank.ts --dry-run",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "index:submit": "node scripts/submit-search-indexing.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "10.74.0",
    "@sentry/node": "10.74.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@tahaddi/config": "workspace:*",
    "@tahaddi/contracts": "workspace:*",
    "@tahaddi/database": "workspace:*",
    "@tahaddi/domain": "workspace:*",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  }
}
