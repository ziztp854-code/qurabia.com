{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "تحدي",
  "version": "0.1.0",
  "identifier": "com.qurabia.tahaddi",
  "build": {
    "frontendDist": "../recovery"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../web/src/app/favicon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
