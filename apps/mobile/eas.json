{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "release-apk": {
      "extends": "production",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      }
    },
    "release-aab": {
      "extends": "production",
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
