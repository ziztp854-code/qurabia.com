{
  "name": "@tahaddi/mobile",
  "version": "0.2.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p ../../packages/domain/tsconfig.json && node scripts/test-native.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/readex-pro": "0.4.1",
    "@tahaddi/domain": "workspace:*",
    "expo": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "@expo-google-fonts/cairo": "0.4.1",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-webrtc": "150.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "livekit-client": "2.23.0",
    "expo-secure-store": "~57.0.4",
    "expo-crypto": "~57.0.3",
    "expo-image": "~57.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
