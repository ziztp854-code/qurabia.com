NODE_ENV=development
APP_NAME=تحدّي
WEB_PORT=3000
REALTIME_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
POSTGRES_DB=tahaddi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tahaddi?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tahaddi?schema=public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=replace-with-a-separate-random-value
AUTH_SECRET=replace-with-a-random-value
# NextAuth v4 also reads NEXTAUTH_SECRET; the web app maps AUTH_SECRET to it.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=tahaddi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# xAI (Grok) integration has been removed. The AI features inside
# apps/web/src/lib/ai short-circuit when no upstream key is set.
# Re-enable by adding XAI_API_KEY, XAI_MODEL, and XAI_DISABLED here.
# Optional error monitoring. Telemetry remains disabled while DSNs are empty.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02
# Search & AI discovery (optional — improves indexing after deploy)
NEXT_PUBLIC_SITE_URL=https://qurabia.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
INDEXNOW_KEY=
