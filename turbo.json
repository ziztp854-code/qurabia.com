{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["prisma/schema.prisma", "prisma/migrations/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@mamluk/maplibre-adapter#build": {
      "dependsOn": ["^build", "@mamluk/world-map-core#build"],
      "outputs": ["dist/**"]
    },
    "@mamluk/maplibre-adapter#typecheck": {
      "dependsOn": ["^build", "@mamluk/world-map-core#build"]
    },
    "@mamluk/maplibre-adapter#test": {
      "dependsOn": ["^build", "@mamluk/world-map-core#build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@tahaddi/database#typecheck": {
      "dependsOn": ["@tahaddi/database#build"]
    },
    "@tahaddi/web#typecheck": {
      "dependsOn": ["^build", "@tahaddi/database#typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
